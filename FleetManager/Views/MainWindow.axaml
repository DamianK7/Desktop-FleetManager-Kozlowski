<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FleetManager.ViewModels"
        xmlns:views="using:FleetManager.Views"
        x:Class="FleetManager.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Fleet Manager - Monitoring"
        Width="900" Height="600"
        Background="#121212">

    <Grid RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Text="Panel Floty" FontSize="26" FontWeight="Bold" Margin="20" Foreground="White"/>

        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Vehicles}" Margin="15">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <views:VehicleItemView Width="280" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>