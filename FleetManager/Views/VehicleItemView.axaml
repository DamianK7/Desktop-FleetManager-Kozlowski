<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FleetManager.ViewModels"
             x:Class="FleetManager.Views.VehicleItemView"
             x:DataType="vm:VehicleItemViewModel">
    
    <Border Padding="15" Margin="10" Background="#1E1E1E" CornerRadius="10" BorderBrush="#333333" BorderThickness="1">
        <StackPanel Spacing="8">
            <TextBlock Text="{Binding Vehicle.Name}" FontSize="20" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="{Binding Vehicle.RegistrationNumber}" FontSize="14" Foreground="#AAAAAA"/>
            
            <Separator Background="#333333" Margin="0,5"/>

            <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock Text="Status:" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Text="{Binding Vehicle.Status}" Foreground="#4CAF50" FontWeight="Bold"/>
            </StackPanel>

            <StackPanel Spacing="5" Margin="0,5,0,10">
                <TextBlock Text="{Binding Vehicle.FuelLevel, StringFormat='Paliwo: {0}%'}" FontSize="12" Foreground="White"/>
                <ProgressBar Value="{Binding Vehicle.FuelLevel}" Minimum="0" Maximum="100" Height="8" Foreground="#2196F3" Background="#333333" CornerRadius="4"/>
            </StackPanel>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,10,0,0">
                <Button Grid.Row="0" Grid.Column="0" Content="⛽ Tankuj" Command="{Binding RefuelCommand}" 
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,5,5"/>
                
                <Button Grid.Row="0" Grid.Column="1" Content="🚚 W trasę" Command="{Binding SendInRouteCommand}" 
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5,0,0,5" Background="#2E7D32"/>
                
                <Button Grid.Row="1" Grid.Column="0" Content="🏢 Baza" Command="{Binding SetAvailableCommand}" 
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,5,5,0"/>
                
                <Button Grid.Row="1" Grid.Column="1" Content="🔧 Serwis" Command="{Binding SetServiceCommand}" 
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5,5,0,0" Background="#C62828"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>